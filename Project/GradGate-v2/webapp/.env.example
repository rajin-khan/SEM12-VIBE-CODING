# Supabase URL and Anon Key are required for Authentication and connecting to the database
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# The URL where your FastAPI backend is hosted. For local dev, this defaults to http://localhost:8000
VITE_API_URL=http://localhost:8000
