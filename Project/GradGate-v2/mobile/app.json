{
    "expo": {
        "name": "GradGate",
        "slug": "gradgate",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/brand/app-icon.png",
        "userInterfaceStyle": "light",
        "scheme": "gradgate",
        "splash": {
            "image": "./assets/brand/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#FAF8F5"
        },
        "ios": {
            "supportsTablet": false,
            "bundleIdentifier": "com.gradgate.app"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#FAF8F5",
                "foregroundImage": "./assets/brand/app-icon.png"
            }
        },
        "web": {
            "favicon": "./assets/brand/app-icon.png"
        },
        "plugins": [
            "expo-router",
            "expo-web-browser",
            "expo-font",
            "expo-secure-store",
            [
                "expo-image-picker",
                {
                    "photosPermission": "Allow GradGate to access your photos to upload transcripts."
                }
            ],
            [
                "expo-document-picker",
                {
                    "iCloudContainerEnvironment": "Production"
                }
            ]
        ]
    }
}
