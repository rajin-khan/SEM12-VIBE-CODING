# Root config for the API and CLI
# Actual file to fill in: Project/GradGate-v2/.env

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anon key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key for API-side database access
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Supabase JWT secret used by the API for local/test token flows
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Local dev only. Keep false in normal use.
TEST_MODE=false

# CLI/API base URL for authenticated cloud history access from the CLI
GRADGATE_API_URL=http://localhost:8000

# OAuth redirect URL to add in Supabase Auth > URL Configuration
GRADGATE_CLI_REDIRECT_URL=http://127.0.0.1:8765/auth/callback
